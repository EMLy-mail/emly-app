@@ -0,0 +1,13 @@
+package binding
+
+// methodSource holds the parameter names and doc comment extracted from Go
+// source for a single bound method. It is populated only in builds tagged
+// "bindings" (see source_ast.go) - i.e. only during `wails generate module
+// -tags bindings` / `wails build -tags bindings`, which is the only place
+// generated .js/.d.ts output is produced. In all other builds
+// (source_stub.go) this is always the zero value, which callers must treat
+// as "no extra info available" and fall back to argN names / no comment.
+type methodSource struct {
+	paramNames []string
+	comment    string
+}
diff --git a/vendor/github.com/wailsapp/wails/v2/internal/binding/source_ast.go b/vendor/github.com/wailsapp/wails/v2/internal/binding/source_ast.go
new file mode 100644
index 0000000..56dde70
--- /dev/null
+++ b/vendor/github.com/wailsapp/wails/v2/internal/binding/source_ast.go
@@ -0,0 +1,134 @@
+//go:build bindings
+
+package binding
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"reflect"
+	"runtime"
+	"strings"
+)
+
+// sourceCache parses each distinct Go source file at most once and caches
+// the result (including parse failures, as a nil entry), since a single
+// bound struct typically has many methods spread across a handful of files
+// and getMethods is only called once per bound struct per process - no
+// concurrency-safety or eviction is needed.
+type sourceCache struct {
+	fset  *token.FileSet
+	files map[string]*ast.File // absolute path -> parsed file; nil = parse failed
+}
+
+func newSourceCache() *sourceCache {
+	return &sourceCache{fset: token.NewFileSet(), files: make(map[string]*ast.File)}
+}
+
+// lookup resolves parameter names and the doc comment for the method
+// described by methodDef (obtained via reflect.Type.Method(i) on the bound
+// struct's pointer type), whose Go receiver type name is receiverName (e.g.
+// "App"). It never returns an error: any failure (no runtime symbol, file
+// unreadable, parse error, no matching *ast.FuncDecl - e.g. a method
+// promoted from an embedded type) simply yields a zero methodSource, and
+// callers fall back to the historical (argN, no comment) behavior.
+func (c *sourceCache) lookup(methodDef reflect.Method, receiverName string) methodSource {
+	pc := methodDef.Func.Pointer()
+	fn := runtime.FuncForPC(pc)
+	if fn == nil {
+		return methodSource{}
+	}
+	file, _ := fn.FileLine(pc)
+	if file == "" {
+		return methodSource{}
+	}
+
+	astFile, cached := c.files[file]
+	if !cached {
+		parsed, err := parser.ParseFile(c.fset, file, nil, parser.ParseComments)
+		if err != nil {
+			parsed = nil
+		}
+		c.files[file] = parsed
+		astFile = parsed
+	}
+	if astFile == nil {
+		return methodSource{}
+	}
+
+	fd := findFuncDecl(astFile, receiverName, methodDef.Name)
+	if fd == nil {
+		return methodSource{}
+	}
+
+	var comment string
+	if fd.Doc != nil {
+		comment = strings.TrimSpace(fd.Doc.Text())
+	}
+	return methodSource{
+		paramNames: extractParamNames(fd),
+		comment:    comment,
+	}
+}
+
+// findFuncDecl scans the top-level declarations of f for a method with the
+// given receiver type name and method name.
+func findFuncDecl(f *ast.File, receiverName, methodName string) *ast.FuncDecl {
+	for _, decl := range f.Decls {
+		fd, ok := decl.(*ast.FuncDecl)
+		if !ok || fd.Recv == nil || fd.Name.Name != methodName {
+			continue
+		}
+		if receiverTypeName(fd.Recv) != receiverName {
+			continue
+		}
+		return fd
+	}
+	return nil
+}
+
+// receiverTypeName extracts the bare type name from a method's receiver
+// field list, unwrapping pointer receivers (*T) and simple generic
+// receivers (T[P]). Returns "" if it can't be determined, which safely
+// fails the match in findFuncDecl.
+func receiverTypeName(recv *ast.FieldList) string {
+	if recv == nil || len(recv.List) != 1 {
+		return ""
+	}
+	expr := recv.List[0].Type
+	if star, ok := expr.(*ast.StarExpr); ok {
+		expr = star.X
+	}
+	switch t := expr.(type) {
+	case *ast.Ident:
+		return t.Name
+	case *ast.IndexExpr: // generic receiver: T[P]
+		if ident, ok := t.X.(*ast.Ident); ok {
+			return ident.Name
+		}
+	}
+	return ""
+}
+
+// extractParamNames flattens a FuncDecl's parameter field list into one
+// name per parameter, in declaration order (the receiver is separate from
+// fd.Type.Params). Grouped names (e.g. "a, b string") expand to one entry
+// per name; a field with no names (unnamed parameter) contributes a single
+// "" placeholder so positional indices still line up with reflect's
+// methodType.NumIn().
+func extractParamNames(fd *ast.FuncDecl) []string {
+	if fd.Type.Params == nil {
+		return nil
+	}
+	var names []string
+	for _, field := range fd.Type.Params.List {
+		if len(field.Names) == 0 {
+			names = append(names, "")
+			continue
+		}
+		for _, n := range field.Names {
+			names = append(names, n.Name)
+		}
+	}
+	return names
+}
