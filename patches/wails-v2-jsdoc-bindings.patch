@@ -0,0 +1,21 @@
+//go:build !bindings
+
+package binding
+
+import "reflect"
+
+// sourceCache is a zero-cost stand-in for regular dev/production builds
+// (anything not built with `-tags bindings`, which only
+// `wails generate module -tags bindings` / `wails build -tags bindings`
+// use). Those builds call binding.NewBindings purely to route frontend
+// calls to Go methods at runtime and never touch generated .js/.d.ts
+// output, so there is no reason to parse Go source on every app startup,
+// nor to depend on Go source files being present alongside a shipped
+// production binary.
+type sourceCache struct{}
+
+func newSourceCache() *sourceCache { return &sourceCache{} }
+
+func (c *sourceCache) lookup(_ reflect.Method, _ string) methodSource {
+	return methodSource{}
+}
