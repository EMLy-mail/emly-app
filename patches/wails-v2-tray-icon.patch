+
+// TraySetSystemTray sets the system tray menu
+func TraySetSystemTray(ctx context.Context, trayMenu *menu.TrayMenu) {
+	frontend := getFrontend(ctx)
+	frontend.TraySetSystemTray(trayMenu)
