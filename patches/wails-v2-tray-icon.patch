+			return 0, fmt.Errorf("failed to load icon from file %q: %w", image, err)
+		}
+		return w32.HICON(ico.Handle()), nil
+	}
+
+	data, err := base64.StdEncoding.DecodeString(image)
+	if err == nil {
+		return w.createIconFromBytes(data)
+	}
